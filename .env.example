# Base URL of the Secure Banking API (Spring Boot)
BANK_API_BASE_URL=http://localhost:8080

# Auth: set EITHER a pre-issued JWT ...
BANK_API_TOKEN=
# ... OR credentials, so the server can log in (and log in again when the token expires)
BANK_EMAIL=
BANK_PASSWORD=

# Optional
BANK_API_TIMEOUT_MS=5000
BANK_API_MAX_RETRIES=3
LOG_LEVEL=info
